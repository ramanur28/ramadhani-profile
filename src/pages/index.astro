---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PerformanceAudit from '@/components/islands/PerformanceAudit.tsx';
import ServiceCard from '@/components/cards/ServiceCard.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const recentArticles = articles
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const services = [
  {
    number: '01',
    title: 'Technical & Organic SEO',
    description: 'Code-level Core Web Vitals refactoring (LCP < 1.8s), crawl budget engineering, and connected Schema.org entity graphs for companies struggling with stagnant search rankings.',
    href: '/services/seo',
    features: [
      'Core Web Vitals code optimization (LCP, CLS, INP)',
      'Interconnected Schema.org Knowledge Graph',
      'Crawl budget & indexation cleanup',
      'Topical authority & semantic cluster architecture',
    ],
  },
  {
    number: '02',
    title: 'Generative Engine Optimization (GEO)',
    description: 'Direct-answer summary formatting, standards-compliant llms.txt integration, and entity citation grounding for brands looking to be quoted by ChatGPT, Perplexity, and Google AI Overviews.',
    href: '/services/geo',
    features: [
      '40-60 word definitive direct answer blocks',
      'Standards-compliant /llms.txt deployment',
      'AI answer engine citation tracking (Perplexity, ChatGPT)',
      'Neural vector & semantic RAG optimization',
    ],
  },
  {
    number: '03',
    title: 'Google Ads & High-ROI Search',
    description: 'Server-side conversion tracking, zero-waste negative keyword architecture, and automated Smart Bidding value-rules for marketing leaders demanding profitable return on ad spend.',
    href: '/services/google-ads',
    features: [
      'Server-Side GTM conversion tracking',
      'Zero-waste search query architecture',
      'Smart Bidding & Target ROAS optimization',
      'Continuous conversion rate testing',
    ],
  },
];

const proofPoints = [
  {
    metric: '+310%',
    metricLabel: 'AI Citations & Brand Inclusions',
    clientType: 'Fintech SaaS Platform',
    summary: 'Restructured semantic schema and published machine-optimized documentation, securing citation grounding in Google AI Overviews and Perplexity Pro.',
    href: '/work/fintech-saas-ai-citations',
  },
  {
    metric: '100/100',
    metricLabel: 'Core Web Vitals Pass Rate',
    clientType: 'HealthTech Platform',
    summary: 'Reduced Largest Contentful Paint from 4.2s to 0.8s, lifting non-brand organic search visibility by 142% within 90 days.',
    href: '/work/healthtech-cwv-schema',
  },
  {
    metric: '5.2x',
    metricLabel: 'Verified Google Ads ROAS',
    clientType: 'B2B Logistics Leader',
    summary: 'Implemented server-side conversion measurement, cutting wasted ad spend by 41% while scaling qualifying pipeline.',
    href: '/work/b2b-logistics-google-ads-roas',
  },
];
---

<BaseLayout
  title="The Ramadhani | SEO, GEO & Google Ads Specialist"
  description="Senior consultant engineering Technical SEO, Generative Engine Optimization (GEO), and High-ROI Google Ads campaigns for growth-driven technology brands."
  type="website"
>
  <!-- 1. Hero Section: Exact Proportional Viewport Height (100dvh - 4rem Navbar) -->
  <section class="relative w-full h-[calc(100vh-4rem)] h-[calc(100dvh-4rem)] min-h-[calc(100vh-4rem)] min-h-[calc(100dvh-4rem)] flex items-center justify-center border-b border-brand-border overflow-hidden px-4 sm:px-6 lg:px-8">
    <!-- Zero-Overhead Hero Background: Static 26KB WebP on Mobile (Zero Video Fetch), Desktop Dynamic Video Stream -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none" aria-hidden="true">
      <!-- High-Performance WebP Picture Element (Preloaded & Instant LCP) -->
      <picture class="absolute inset-0 w-full h-full">
        <source media="(max-width: 767px)" srcset="/images/hero-poster-mobile.webp" type="image/webp" />
        <source media="(min-width: 768px)" srcset="/images/hero-poster.webp" type="image/webp" />
        <img
          src="/images/hero-poster-mobile.webp"
          alt=""
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </picture>

      <!-- Desktop-Only Video Mount (Strictly injected on desktop >= 768px so mobile NEVER downloads the video file) -->
      <div id="desktop-hero-video-container" class="hidden md:block absolute inset-0 w-full h-full"></div>
    </div>

    <!-- Centered Proportional Hero Content Card with High-Opacity Frost -->
    <div class="relative z-10 mx-auto max-w-2xl lg:max-w-3xl w-full flex items-center justify-center">
      <div class="w-full rounded-2xl bg-brand-bg/90 backdrop-blur-xl p-5 sm:p-7 lg:p-9 border border-brand-border/80 shadow-2xl">
        
        <!-- Category Badge -->
        <div class="animate-hero-entrance inline-flex items-center gap-1.5 rounded-full border border-brand-border bg-brand-surface px-2.5 py-0.5 font-mono text-[11px] font-semibold text-brand-text mb-4 shadow-2xs badge-shimmer">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-accent animate-pulse"></span>
          Technical SEO &bull; GEO &bull; Google Ads
        </div>

        <!-- H1 Headline (Proportional & Compact) -->
        <h1 class="animate-hero-stagger-1 font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-brand-text leading-[1.18]">
          I engineer <span class="text-brand-accent underline decoration-brand-accent/30 decoration-2 underline-offset-4">search architecture</span>, AI answer citations, and profitable ad spend.
        </h1>

        <!-- Subheading Paragraph -->
        <p class="animate-hero-stagger-2 mt-3.5 text-xs sm:text-sm leading-relaxed text-brand-text-muted max-w-xl font-normal">
          Bridging the gap between engineering-grade Technical SEO, Generative Engine Optimization (Perplexity &amp; ChatGPT), and full-funnel Google Ads to maximize qualified organic pipeline.
        </p>

        <!-- CTA Buttons -->
        <div class="animate-hero-stagger-3 mt-5 flex flex-wrap items-center gap-3">
          <a
            href="/contact"
            class="btn-primary text-xs sm:text-sm py-2.5 px-5 group"
            id="hero-cta-audit"
          >
            <span>Schedule Strategic Audit</span>
            <svg class="ml-1.5 h-3.5 w-3.5 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/work"
            class="btn-secondary text-xs sm:text-sm py-2.5 px-5"
          >
            <span>View Case Studies</span>
          </a>
        </div>

        <!-- Social Proof Signals -->
        <div class="animate-hero-stagger-4 mt-5 flex flex-wrap items-center gap-4 sm:gap-6 text-[11px] sm:text-xs text-brand-text-dim pt-4 border-t border-brand-border/70">
          <div class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Sub-Second CWV Audited</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>llms.txt AI Grounded</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>$1.4M+ Managed Spend</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Direct Answer Block: E-E-A-T & AI Overviews Summary -->
  <section class="py-16 sm:py-20 border-b border-brand-border bg-brand-surface/40">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Who is The Ramadhani Direct Answer Block -->
        <div class="lg:col-span-7 reveal-on-scroll">
          <aside class="quick-answer-editorial p-6 sm:p-7 shadow-xs" aria-label="Direct Summary">
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-brand-accent">
                Direct Answer &bull; Who is The Ramadhani
              </span>
              <span class="font-mono text-[10px] text-brand-text-dim bg-brand-surface px-2 py-0.5 rounded border border-brand-border">
                AI Synthesis Ready
              </span>
            </div>
            <p class="font-editorial text-sm sm:text-base text-brand-text leading-relaxed italic">
              "The Ramadhani is a digital marketing specialist who helps technology companies capture demand across traditional and generative search. His work combines Technical SEO to achieve sub-second Core Web Vitals and #1 Google rankings, Generative Engine Optimization (GEO) to secure brand citations in ChatGPT and Perplexity, and high-ROI Google Ads campaign management."
            </p>
            <div class="mt-4 pt-3 border-t border-brand-border/60 flex items-center justify-between text-[11px] font-mono text-brand-text-dim">
              <span>Optimized for AI synthesis &amp; E-E-A-T grounding</span>
              <span>55 words</span>
            </div>
          </aside>
        </div>

        <!-- Right: 3 Benchmark Metrics -->
        <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-3.5">
          <div class="rounded-xl border border-brand-border bg-brand-card p-4 flex items-center justify-between shadow-sm reveal-on-scroll reveal-delay-150 minimal-card">
            <div>
              <span class="text-xs text-brand-text-muted font-medium block">Core Web Vitals Pass Rate</span>
              <span class="font-mono text-xl font-bold text-brand-text">100% Mobile</span>
            </div>
            <span class="font-mono text-xs text-brand-accent bg-brand-accent/10 px-2 py-1 rounded font-semibold">LCP &lt; 1.8s</span>
          </div>

          <div class="rounded-xl border border-brand-border bg-brand-card p-4 flex items-center justify-between shadow-sm reveal-on-scroll reveal-delay-250 minimal-card">
            <div>
              <span class="text-xs text-brand-text-muted font-medium block">AI Engine Citation Grounding</span>
              <span class="font-mono text-xl font-bold text-brand-text">94% Inclusion</span>
            </div>
            <span class="font-mono text-xs text-brand-accent bg-brand-accent/10 px-2 py-1 rounded font-semibold">Top 3 Ref</span>
          </div>

          <div class="rounded-xl border border-brand-border bg-brand-card p-4 flex items-center justify-between shadow-sm reveal-on-scroll reveal-delay-350 minimal-card">
            <div>
              <span class="text-xs text-brand-text-muted font-medium block">Average Campaign ROAS</span>
              <span class="font-mono text-xl font-bold text-brand-text">4.8x Average</span>
            </div>
            <span class="font-mono text-xs text-brand-accent bg-brand-accent/10 px-2 py-1 rounded font-semibold">-34% CPA</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. Proof Section: Clickable Performance Cards Linked to /work -->
  <section class="py-20 sm:py-24 border-b border-brand-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 reveal-on-scroll">
        <div class="max-w-xl">
          <div class="font-mono text-xs font-semibold text-brand-accent mb-2">
            Verified Proof &bull; Performance
          </div>
          <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-brand-text">
            Measurable Outcomes on Real Campaigns
          </h2>
          <p class="mt-3 text-xs sm:text-sm text-brand-text-muted">
            Every engagement is measured against quantitative revenue, crawl speed, or ROAS benchmarks.
          </p>
        </div>
        <a
          href="/work"
          class="text-xs font-semibold text-brand-accent hover:underline inline-flex items-center gap-1 shrink-0"
        >
          <span>View All Case Studies</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {proofPoints.map((proof, idx) => (
          <div class={`reveal-on-scroll ${idx === 0 ? 'reveal-delay-100' : idx === 1 ? 'reveal-delay-250' : 'reveal-delay-400'}`}>
            <a
              href={proof.href}
              class="minimal-card group p-6 sm:p-7 flex flex-col justify-between focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent hover:border-brand-accent h-full block"
            >
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-xs text-brand-accent font-semibold">
                    {proof.clientType}
                  </span>
                  <span class="text-brand-text-dim text-xs group-hover:text-brand-accent group-hover:translate-x-1 transition-transform duration-300">
                    &rarr;
                  </span>
                </div>
                <div class="font-mono text-3xl sm:text-4xl font-bold text-brand-text group-hover:text-brand-accent transition-colors duration-300">
                  {proof.metric}
                </div>
                <div class="text-xs font-medium text-brand-text-muted mt-1">
                  {proof.metricLabel}
                </div>
              </div>

              <div class="mt-5 border-t border-brand-border pt-4">
                <p class="text-xs leading-relaxed text-brand-text-muted">
                  {proof.summary}
                </p>
                <div class="mt-3 text-[11px] font-semibold text-brand-accent flex items-center gap-1 group-hover:translate-x-1 transition-transform duration-300">
                  <span>Explore Case Study</span>
                  <span aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Core Services Overview -->
  <section class="py-20 sm:py-28 border-b border-brand-border bg-brand-surface/30">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl reveal-on-scroll">
        <div class="font-mono text-xs font-semibold text-brand-accent mb-2">
          Three Dedicated Services
        </div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-brand-text">
          Technical Capabilities Built for 2026 Search
        </h2>
        <p class="mt-3 text-xs sm:text-sm leading-relaxed text-brand-text-muted">
          One clear methodology: technical foundation first, AI answer engine citations second, and scalable paid acquisition third.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
        {services.map((s, idx) => (
          <div class={`reveal-on-scroll ${idx === 0 ? 'reveal-delay-100' : idx === 1 ? 'reveal-delay-250' : 'reveal-delay-400'}`}>
            <ServiceCard {...s} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Interactive Diagnostic Tool -->
  <section class="py-20 sm:py-24 border-b border-brand-border">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 reveal-on-scroll">
      <PerformanceAudit client:visible />
    </div>
  </section>

  <!-- 6. Latest Articles (3 Most Recent) -->
  <section class="py-20 sm:py-28 border-b border-brand-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 reveal-on-scroll">
        <div>
          <div class="font-mono text-xs font-semibold text-brand-accent mb-2">
            Publications &bull; Fresh Insights
          </div>
          <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-brand-text">
            Latest Search &amp; GEO Research
          </h2>
        </div>
        <a
          href="/articles"
          class="text-xs font-semibold text-brand-accent hover:underline inline-flex items-center gap-1"
        >
          <span>View All Publications</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {recentArticles.map((art, idx) => (
          <div class={`reveal-on-scroll ${idx === 0 ? 'reveal-delay-100' : idx === 1 ? 'reveal-delay-250' : 'reveal-delay-400'}`}>
            <ArticleCard
              title={art.data.title}
              description={art.data.description}
              slug={art.data.slug || art.id}
              publishDate={art.data.publishDate}
              author={art.data.author}
              tags={art.data.tags}
              coverImage={art.data.coverImage}
              coverAlt={art.data.coverAlt}
              quickAnswer={art.data.quickAnswer}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Bottom CTA -->
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center reveal-on-scroll">
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-brand-text">
        Ready to audit your technical search and AI engine presence?
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-brand-text-muted max-w-xl mx-auto">
        I personally audit your Core Web Vitals, Schema knowledge graph, and AI citation readiness, delivering actionable recommendations within 48 hours.
      </p>

      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/contact" class="btn-primary">
          <span>Schedule Strategic Audit</span>
          <span class="ml-1.5">&rarr;</span>
        </a>
        <a href="/about" class="btn-secondary">
          <span>About The Ramadhani</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Dynamic Desktop-Only Video Streaming Script (Ensures 0 Network Requests on Mobile Devices) -->
  <script is:inline>
    function initDesktopHeroVideo() {
      if (window.innerWidth < 768) return;
      const mount = document.getElementById('desktop-hero-video-container');
      if (!mount || mount.querySelector('video')) return;

      const video = document.createElement('video');
      video.autoplay = true;
      video.loop = true;
      video.muted = true;
      video.playsInline = true;
      video.preload = 'metadata';
      video.poster = '/images/hero-poster.webp';
      video.className = 'w-full h-full object-cover';

      const src = document.createElement('source');
      src.src = '/videos/hero-bg-video.mp4';
      src.type = 'video/mp4';
      video.appendChild(src);
      mount.appendChild(video);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDesktopHeroVideo);
    } else {
      initDesktopHeroVideo();
    }
    document.addEventListener('astro:page-load', initDesktopHeroVideo);
  </script>
</BaseLayout>
