---
import PageLayout from '@/layouts/PageLayout.astro';
import type { BreadcrumbItem } from '@/types/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Contact', url: '/contact' },
];
---

<PageLayout
  title="Contact The Ramadhani | Direct Strategic Growth Consultation"
  description="Schedule a technical SEO code audit, Generative Engine Optimization (GEO) roadmap, or Google Ads account review with Ramadhani."
  headline="Direct, no-fluff search consulting for technology brands."
  subheadline="I personally audit your technical search architecture, AI answer engine citations, and Google Ads efficiency. Guaranteed response within 24 business hours."
  badge="Direct Consultation"
  breadcrumbs={breadcrumbs}
  type="contact"
>
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
    <!-- Left: Low-Friction Inquiry Form -->
    <div class="lg:col-span-7">
      <div class="minimal-card p-8 sm:p-10">
        <h2 class="font-display text-xl font-bold text-brand-text mb-2">
          Request Strategic Growth Audit
        </h2>
        <p class="text-xs text-brand-text-muted mb-8">
          Fill out the brief details below. I personally review your domain and respond within 24 business hours.
        </p>

        <form
          action="/api/contact"
          method="POST"
          class="space-y-5"
          id="contact-form"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-xs font-medium text-brand-text-muted mb-1.5 font-mono">
                Your Name *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Alex Morgan"
                class="w-full rounded-lg border border-brand-border bg-brand-surface px-3.5 py-2.5 text-xs text-brand-text placeholder-brand-text-dim focus:border-brand-accent focus:outline-none"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-medium text-brand-text-muted mb-1.5 font-mono">
                Work Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="alex@company.com"
                class="w-full rounded-lg border border-brand-border bg-brand-surface px-3.5 py-2.5 text-xs text-brand-text placeholder-brand-text-dim focus:border-brand-accent focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="website" class="block text-xs font-medium text-brand-text-muted mb-1.5 font-mono">
                Website URL *
              </label>
              <input
                type="url"
                id="website"
                name="website"
                required
                placeholder="https://company.com"
                class="w-full rounded-lg border border-brand-border bg-brand-surface px-3.5 py-2.5 text-xs text-brand-text placeholder-brand-text-dim focus:border-brand-accent focus:outline-none"
              />
            </div>

            <div>
              <label for="service" class="block text-xs font-medium text-brand-text-muted mb-1.5 font-mono">
                Primary Focus *
              </label>
              <select
                id="service"
                name="service"
                required
                class="w-full rounded-lg border border-brand-border bg-brand-surface px-3.5 py-2.5 text-xs text-brand-text focus:border-brand-accent focus:outline-none"
              >
                <option value="seo">Technical &amp; Organic SEO</option>
                <option value="geo">Generative Engine Optimization (GEO)</option>
                <option value="ads">Google Ads &amp; ROAS Optimization</option>
                <option value="full">Full-Stack Search Architecture (All 3)</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-medium text-brand-text-muted mb-1.5 font-mono">
              Objectives &amp; Current Bottlenecks *
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Tell me about your organic search goals, Core Web Vitals issues, or paid ad targets..."
              class="w-full rounded-lg border border-brand-border bg-brand-surface px-3.5 py-2.5 text-xs text-brand-text placeholder-brand-text-dim focus:border-brand-accent focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="btn-primary w-full text-xs py-3"
          >
            <span>Submit Strategic Inquiry</span>
            <span class="ml-1.5">&rarr;</span>
          </button>
        </form>

        <div id="form-success" class="hidden mt-6 rounded-xl border border-brand-accent/40 bg-brand-accent/10 p-5 text-center text-xs text-brand-text">
          <p class="font-bold text-brand-accent">Inquiry Received</p>
          <p class="mt-1 text-brand-text-muted">I have received your details and will reply with diagnostic feedback within 24 business hours.</p>
        </div>
      </div>
    </div>

    <!-- Right: Direct Expectations & Engagement Details -->
    <div class="lg:col-span-5 space-y-6">
      <div class="minimal-card p-6 sm:p-7">
        <h3 class="font-display text-sm font-bold text-brand-text mb-4">Direct Communication</h3>
        <div class="space-y-3 text-xs text-brand-text-muted">
          <div>
            <span class="block text-brand-text-dim font-mono text-[11px]">Direct Email:</span>
            <a href="mailto:contact@ramadhani.dev" class="font-semibold text-brand-text hover:text-brand-accent transition-colors">
              contact@ramadhani.dev
            </a>
          </div>
          <div>
            <span class="block text-brand-text-dim font-mono text-[11px]">Response Time Commitment:</span>
            <span class="font-semibold text-brand-text">&lt; 24 Business Hours</span>
          </div>
          <div>
            <span class="block text-brand-text-dim font-mono text-[11px]">Consulting Model:</span>
            <span class="font-medium text-brand-text">Direct 1-on-1 Specialist Advisory (Worldwide)</span>
          </div>
        </div>
      </div>

      <div class="minimal-card p-6 sm:p-7">
        <h3 class="font-display text-sm font-bold text-brand-text mb-4">Consultation Process</h3>
        <ol class="space-y-3.5 text-xs text-brand-text-muted">
          <li class="flex gap-2.5">
            <span class="font-mono text-brand-accent font-bold">01.</span>
            <span><strong class="text-brand-text">Diagnostic Review:</strong> I analyze your domain's Core Web Vitals, Schema graph, and AI citation presence prior to our call.</span>
          </li>
          <li class="flex gap-2.5">
            <span class="font-mono text-brand-accent font-bold">02.</span>
            <span><strong class="text-brand-text">30-Min Strategy Call:</strong> We review immediate wasted spend, indexation bottlenecks, and revenue growth levers.</span>
          </li>
          <li class="flex gap-2.5">
            <span class="font-mono text-brand-accent font-bold">03.</span>
            <span><strong class="text-brand-text">Direct Execution:</strong> Clear deliverables, direct code pull requests, and ongoing telemetry reporting.</span>
          </li>
        </ol>
      </div>
    </div>
  </div>

  <script>
    function setupForm() {
      const form = document.getElementById('contact-form') as HTMLFormElement;
      const success = document.getElementById('form-success');
      if (!form || !success) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.classList.add('opacity-40', 'pointer-events-none');
        setTimeout(() => {
          form.classList.add('hidden');
          success.classList.remove('hidden');
        }, 400);
      });
    }

    setupForm();
    document.addEventListener('astro:page-load', setupForm);
  </script>
</PageLayout>