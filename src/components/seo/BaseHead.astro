---
import { ClientRouter } from 'astro:transitions';
import type { ServiceSchemaData, ArticleSchemaData, PersonSchemaData, FAQItem, BreadcrumbItem } from '@/types/schema';
import JsonLd from './JsonLd.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: ArticleSchemaData;
  service?: ServiceSchemaData;
  person?: PersonSchemaData;
  faq?: FAQItem[];
  breadcrumbs?: BreadcrumbItem[];
  type?: 'website' | 'article' | 'service' | 'person' | 'about' | 'contact';
}

const {
  title,
  description,
  image = '/images/og-default.svg',
  article,
  service,
  person,
  faq,
  breadcrumbs,
  type = 'website',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://theramadhani.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
const siteName = 'The Ramadhani | SEO, GEO & Google Ads Specialist';
const fullTitle = title.includes('The Ramadhani') ? title : `${title} | The Ramadhani`;
---

<!-- High Priority Charset & Viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content="The Ramadhani" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#FAFAF8" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:site" content="@theramadhani_seo" />
<meta property="twitter:creator" content="@theramadhani_seo" />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

<!-- Favicon & Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Feeds & Sitemaps -->
<link rel="alternate" type="application/rss+xml" title="The Ramadhani Insights RSS Feed" href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- LLM Discovery Directive -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context & Summary" />

<!-- Optimized Typography: Alex Brush (Script) + Great Vibes + Inter + Plus Jakarta Sans + Newsreader + JetBrains Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Great+Vibes&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
  rel="stylesheet"
/>

<!-- View Transitions API -->
<ClientRouter />

<!-- Structured Data (JSON-LD) -->
<JsonLd
  type={type}
  title={fullTitle}
  description={description}
  canonicalUrl={canonicalURL.toString()}
  article={article}
  service={service}
  person={person}
  faq={faq}
  breadcrumbs={breadcrumbs}
/>
