---
// Clean, sticky navigation header with accessible dropdown
const pathname = Astro.url.pathname;

const services = [
  {
    name: 'Technical & Organic SEO',
    href: '/services/seo',
    desc: 'Architecture, schema graphs, rendering & indexing.',
    badge: 'Code-First'
  },
  {
    name: 'Generative Engine Optimization (GEO)',
    href: '/services/geo',
    desc: 'Answer engine visibility (Perplexity, ChatGPT, AI Overviews).',
    badge: 'AI Search'
  },
  {
    name: 'Google Ads & Paid Search',
    href: '/services/google-ads',
    desc: 'High-intent search capture & ROAS turnaround.',
    badge: 'High ROAS'
  }
];

const otherLinks = [
  { name: 'Proof / Work', href: '/work' },
  { name: 'Articles', href: '/articles' },
  { name: 'About', href: '/about' },
];

const isServicesActive = services.some(s => pathname.startsWith(s.href));
---

<header class="sticky top-0 z-40 w-full border-b border-brand-border bg-brand-bg/85 backdrop-blur-md transition-all">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo / Monogram -->
    <a href="/" class="group flex items-center gap-2 focus:outline-none" aria-label="The Ramadhani - Technical SEO & GEO Consultant">
      <img
        src="/images/brand-logo.webp"
        alt="The Ramadhani monogram"
        width="36"
        height="36"
        class="h-9 w-9 object-contain group-hover:scale-105 transition-transform duration-200"
      />
      <span class="font-script text-[28px] sm:text-[32px] font-normal text-brand-text group-hover:text-brand-accent transition-colors leading-none tracking-normal pt-1.5">
        The Ramadhani
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-6 md:flex" aria-label="Main Navigation">
      
      <!-- Services Dropdown Item -->
      <div class="relative group" id="services-dropdown-container">
        <button
          type="button"
          id="services-menu-button"
          class:list={[
            "inline-flex items-center gap-1 text-xs font-medium transition-colors py-2 focus:outline-none cursor-pointer",
            isServicesActive
              ? "text-brand-accent font-semibold"
              : "text-brand-text-muted hover:text-brand-text"
          ]}
          aria-expanded="false"
          aria-haspopup="true"
          aria-label="Services menu"
        >
          <span>Services</span>
          <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 text-brand-text-dim" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu Box -->
        <div
          id="services-dropdown-menu"
          class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 absolute left-0 top-full pt-2 w-80 transition-all duration-150 z-50"
        >
          <div class="rounded-xl border border-brand-border bg-brand-card p-2 shadow-xl">
            {services.map((item) => {
              const isCurrent = pathname === item.href;
              return (
                <a
                  href={item.href}
                  aria-label={`${item.name} - ${item.desc}`}
                  class:list={[
                    "flex flex-col gap-0.5 rounded-lg p-2.5 transition-colors",
                    isCurrent
                      ? "bg-brand-surface text-brand-accent"
                      : "hover:bg-brand-surface text-brand-text"
                  ]}
                >
                  <div class="flex items-center justify-between text-xs font-semibold">
                    <span>{item.name}</span>
                    <span class="font-mono text-[10px] text-brand-accent bg-brand-accent/10 px-1.5 py-0.5 rounded">
                      {item.badge}
                    </span>
                  </div>
                  <p class="text-[11px] text-brand-text-muted leading-snug">
                    {item.desc}
                  </p>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Other Links -->
      {otherLinks.map((link) => {
        const isActive = pathname.startsWith(link.href);
        return (
          <a
            href={link.href}
            aria-label={link.name}
            class:list={[
              "text-xs font-medium transition-colors",
              isActive
                ? "text-brand-accent font-semibold"
                : "text-brand-text-muted hover:text-brand-text"
            ]}
          >
            {link.name}
          </a>
        );
      })}

      <!-- Primary CTA -->
      <a
        href="/contact"
        aria-label="Book Strategic Performance Audit"
        class="ml-2 inline-flex items-center justify-center rounded-lg bg-brand-accent px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-brand-accent-hover transition-colors focus-visible:ring-2 focus-visible:ring-brand-accent"
      >
        Book Audit
      </a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <div class="flex items-center md:hidden">
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex items-center justify-center rounded-lg p-1.5 text-brand-text-muted hover:text-brand-text focus:outline-none"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <svg class="h-5 w-5" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-5 w-5" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden border-b border-brand-border bg-brand-bg px-4 py-4 md:hidden">
    <div class="space-y-3">
      <!-- Services Group -->
      <div class="space-y-1">
        <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-brand-accent px-3 py-1">
          Services
        </div>
        {services.map((item) => (
          <a
            href={item.href}
            aria-label={`${item.name} - ${item.desc}`}
            class="block rounded-lg px-3 py-2 text-xs font-medium text-brand-text hover:bg-brand-surface"
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- Other Links -->
      <div class="border-t border-brand-border pt-2 space-y-1">
        {otherLinks.map((link) => (
          <a
            href={link.href}
            aria-label={link.name}
            class="block rounded-lg px-3 py-2 text-sm text-brand-text hover:bg-brand-surface"
          >
            {link.name}
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="pt-2">
        <a
          href="/contact"
          aria-label="Book Strategic Performance Audit"
          class="block w-full rounded-lg bg-brand-accent py-2.5 text-center text-xs font-semibold text-white hover:bg-brand-accent-hover"
        >
          Book Strategic Audit
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!btn || !menu || !iconOpen || !iconClose) return;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isOpen).toString());
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>
